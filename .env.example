# Copy to .env and fill in real values. .env is gitignored.

# Backend-only — Neon Postgres connection string. NEVER prefix with
# EXPO_PUBLIC_ (that would ship the DB credential to the client bundle).
# Consumed by src/lib/auth.ts (better-auth) via app/api/auth/[...all]+api.ts.
# Get it from the `neon` MCP tools or console.neon.tech.
DATABASE_URL=

# better-auth — server config (src/lib/auth.ts). Generate the secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8081

# Client-side — safe to expose. Where the Expo app finds the API routes.
# Use your LAN IP instead of localhost when testing on a physical device.
EXPO_PUBLIC_SERVER_URL=http://localhost:8081

# Existing client-side demo keys (see src/lib/env.ts) — fall back to
# synthetic demo data when unset.
EXPO_PUBLIC_SARVAM_API_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
